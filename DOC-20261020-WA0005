          </button>
        </div>

        <div id="ai-advisor-panel" style="margin-bottom:${state.aiAdvisorHtml ? '18px' : '0'}">
          ${state.aiAdvisorHtml || ''}
        </div>

        <div class="grid-kpi">
          ${getDashboardKPIs().map(k => `
            <div class="card kpi-card">
              <span class="mu" style="font-size:13px;font-weight:700">${k.title}</span>
              <b>${k.value}</b>
              <div>${renderBadge(k.badge, k.cls)}</div>
            </div>
          `).join('')}
        </div>

        <div class="grid-2" style="margin-top:18px">
          <div class="card">
            <div class="row" style="margin-bottom:6px">
              <h3>نمو المبيعات وصافي الأرباح (١٢ شهرًا)</h3>
              <span class="sp"></span>
              <span class="mu" style="font-size:12px">مرّر الماوس على الأعمدة للتفاصيل</span>
            </div>
            ${renderSalesChart()}
          </div>

          <div class="card">
            <h3>توزيع المبيعات حسب السوق</h3>
            ${renderProgressRow('أمازون مصر', 52, '#232f3e', '١٣٧٬٢٨٠ ج.م')}
            ${renderProgressRow('نون مصر', 31, '#f5c400', '٨١٬٨٤٠ ج.م')}
            ${renderProgressRow('جوميا', 17, '#f68b1e', '٤٤٬٨٨٠ ج.م')}

            <h3 style="margin-top:20px">طرق الدفع المفضلة للعملاء</h3>
            ${renderProgressRow('الدفع عند الاستلام (COD)', 64, 'var(--ac)')}
            ${renderProgressRow('فودافون كاش وإنستاباي', 21, 'var(--pr)')}
            ${renderProgressRow('البطاقات البنكية وفوري', 15, 'var(--ok)')}
          </div>
        </div>

        <div class="grid-2" style="margin-top:18px">
          <div class="card">
            <div class="row" style="margin-bottom:12px">
              <h3>أحدث الطلبات الواردة</h3>
              <span class="sp"></span>
              <a class="pr-tx" style="font-size:13px;font-weight:700" href="#/ord">عرض الكل ◂</a>
            </div>
            ${renderTable(
              ['رقم الطلب', 'السوق', 'العميل', 'المحافظة', 'الإجمالي', 'الحالة'],
              filteredOrders.map(o => [
                `<b>#${o.id}</b>`,
                renderMarketChip(o.market),
                esc(o.customer),
                o.gov,
                `<b>${fmtEGP(o.total)}</b>`,
                renderBadge(ORDER_STATUS[o.status].label, ORDER_STATUS[o.status].cls)
              ])
            )}
          </div>

          <div class="card">
            <div class="row" style="margin-bottom:10px">
              <h3>⚠️ تنبيهات مخزون أوشك على النفاد</h3>
              <span class="sp"></span>
              <a class="pr-tx" style="font-size:13px;font-weight:700" href="#/prod">إدارة المخزون ◂</a>
            </div>
            ${lowStockItems.length ? lowStockItems.map(p => {
              const sb = getStockBadge(p.stock);
              return `
                <div class="row" style="padding:9px 0;border-bottom:1px solid var(--bd)">
                  <div class="sp">
                    <b style="font-size:14px;display:block">${esc(p.name)}</b>
                    <small class="mu">SKU: ${p.sku} · متبقي <b>${fmtNum(p.stock)}</b> قطع</small>
                  </div>
                  ${renderBadge(sb.text, sb.cls)}
                  <button class="btn btn-gh btn-sm" data-a="quick-restock" data-id="${p.id}" title="تزويد ١٠ قطع فورًا">+١٠ قطع</button>
                </div>
              `;
            }).join('') : `<p class="mu ctr" style="padding:20px">🎉 جميع منتجاتك متوفرة بكميات آمنة!</p>`}
          </div>
        </div>
      `;
    };

    // 5.2 صفحة المنتجات والمخزون (#/prod)
    const renderProductsTable = () => {
      const q = state.prodQuery.trim().toLowerCase();
      const filtered = products.filter(p => {
        const matchesQuery = (p.name + ' ' + p.sku + ' ' + (p.cat || '')).toLowerCase().includes(q);
        const matchesStock =
          state.prodStockFilter === 'all' ||
          (state.prodStockFilter === 'low' && p.stock <= 5) ||
          (state.prodStockFilter === 'warn' && p.stock > 5 && p.stock <= 15) ||
          (state.prodStockFilter === 'ok' && p.stock > 15);
        return matchesQuery && matchesStock;
      });

      return renderTable(
        ['المنتج', 'SKU', 'الأسواق النشطة', 'التكلفة', 'سعر البيع', 'هامش الربح', 'المخزون', 'الحالة', 'إجراءات'],
        filtered.map(p => {
          const margin = p.price ? ((p.price - p.cost) / p.price) * 100 : 0;
          const sb = getStockBadge(p.stock);
          return [
            `<div><b>${esc(p.name)}</b><br><small class="mu">${esc(p.cat || 'عام')}</small></div>`,
            `<code dir="ltr" style="background:var(--bg-sub);padding:2px 7px;border-radius:6px">${esc(p.sku)}</code>`,
            `<div class="row" style="gap:5px">${['a', 'n', 'j'].map(k => `
              <span style="cursor:pointer;opacity:${p.markets.includes(k) ? '1' : '0.25'}" data-a="toggle-prod-mkt" data-id="${p.id}" data-m="${k}" title="اضغط لتفعيل/إيقاف السوق">
                ${renderMarketChip(k)}
              </span>
            `).join('')}</div>`,
            fmtEGP(p.cost),
            `<b>${fmtEGP(p.price)}</b>`,
            renderBadge(fmtNum(margin) + '٪', margin >= 25 ? 'ok' : margin >= 12 ? 'wn' : 'er'),
            `<b>${fmtNum(p.stock)}</b>`,
            renderBadge(sb.text, sb.cls),
            `<div class="row" style="gap:6px">
              <button class="btn btn-gh btn-sm" data-a="edit-prod" data-id="${p.id}">✎ تعديل</button>
              <button class="btn btn-gh btn-sm" data-a="quick-restock" data-id="${p.id}">+١٠</button>
            </div>`
          ];
        })
      );
    };

    views.prod = () => `
      <div class="card">
        <div class="row-wrap" style="margin-bottom:14px">
          <span class="pill ${state.prodStockFilter === 'all' ? 'on' : ''}" data-a="prod-flt" data-v="all">الكل (${fmtNum(products.length)})</span>
          <span class="pill ${state.prodStockFilter === 'ok' ? 'on' : ''}" data-a="prod-flt" data-v="ok">متوفر</span>
          <span class="pill ${state.prodStockFilter === 'warn' ? 'on' : ''}" data-a="prod-flt" data-v="warn">قارب النفاد</span>
          <span class="pill ${state.prodStockFilter === 'low' ? 'on' : ''}" data-a="prod-flt" data-v="low">منخفض جدًا</span>
          <span class="sp"></span>
          <button class="btn btn-gh btn-sm" data-a="export-csv">📥 تصدير الكتالوج CSV</button>
          <button class="btn btn-ac btn-sm" data-a="add-prod">+ إضافة منتج جديد</button>
        </div>
        <input data-i="prod-search" placeholder="🔍 ابحث باسم المنتج أو كود SKU أو الفئة..." value="${esc(state.prodQuery)}">
        <p class="mu" style="font-size:12.5px;margin-bottom:10px">💡 نصيحة: اضغط على أيقونة السوق (أ / ن / ج) بجانب أي منتج لتشغيل أو إيقاف عرضه على تلك المنصة فوراً.</p>
        <div id="prod-table-box">${renderProductsTable()}</div>
      </div>
    `;

    // 5.3 صفحة الطلبات والفواتير (#/ord)
    const renderOrdersTable = () => {
      const q = state.orderQuery.trim();
      const filtered = orders.filter(o => {
        const matchStatus = state.orderStatusFilter < 0 || o.status === state.orderStatusFilter;
        const matchQuery = (o.id + ' ' + o.customer + ' ' + o.gov + ' ' + o.courier).includes(q);
        return matchStatus && matchQuery;
      });

      return renderTable(
        ['رقم الطلب', 'السوق', 'العميل والمنتج', 'المحافظة', 'الدفع', 'الشحن', 'الإجمالي', 'الحالة', 'إجراءات'],
        filtered.map(o => [
          `<b>#${o.id}</b><br><small class="mu">${o.date}</small>`,
          renderMarketChip(o.market),
          `<div><b>${esc(o.customer)}</b><br><small class="mu">${esc(o.items || 'منتجات متنوعة')}</small></div>`,
          o.gov,
          o.pay,
          o.courier,
          `<b>${fmtEGP(o.total)}</b>`,
          renderBadge(ORDER_STATUS[o.status].label, ORDER_STATUS[o.status].cls),
          `<div class="row" style="gap:6px">
            ${o.status < 2 ? `<button class="btn btn-gh btn-sm" data-a="next-status" data-id="${o.id}">تحديث الحالة ◂</button>` : ''}
            <button class="btn btn-gh btn-sm" data-a="ai-order-msg" data-id="${o.id}" title="توليد رسالة واتساب ذكية للعميل لتأكيد الطلب وتقليل المرتجع">💬 رسالة ذكية</button>
            <button class="btn btn-gh btn-sm" data-a="view-invoice" data-id="${o.id}">🧾 فاتورة</button>
          </div>`
        ])
      );
    };

    views.ord = () => `
      <div class="card">
        <div class="row-wrap" style="margin-bottom:14px">
          ${['كل الطلبات', ...ORDER_STATUS.map(s => s.label)].map((label, idx) => `
            <span class="pill ${state.orderStatusFilter === idx - 1 ? 'on' : ''}" data-a="ord-flt" data-v="${idx - 1}">${label}</span>
          `).join('')}
          <span class="sp"></span>
          <button class="btn btn-gh btn-sm" data-a="bulk-awb">🚚 طباعة بوالص الشحن (AWB)</button>
        </div>
        <input data-i="ord-search" placeholder="🔍 ابحث برقم الطلب، اسم العميل، المحافظة أو شركة الشحن..." value="${esc(state.orderQuery)}">
        <div id="ord-table-box">${renderOrdersTable()}</div>
      </div>
    `;

    // 5.4 صفحة تحصيلات الدفع عند الاستلام (#/cod)
    views.cod = () => {
      const b = state.codBalances;
      const totalCollected = b.bosta.collected + b.aramex.collected + b.mylerz.collected;
      const totalPending = b.bosta.pending + b.aramex.pending + b.mylerz.pending;
      const totalFees = b.bosta.fees + b.aramex.fees + b.mylerz.fees;

      const couriers = [
        { key: 'bosta', name: 'بوسطة (Bosta)', cycle: 'تحويل يومي متاح', data: b.bosta },
        { key: 'aramex', name: 'أرامكس (Aramex)', cycle: 'تحويل مرتين أسبوعيًا', data: b.aramex },
        { key: 'mylerz', name: 'مايلرز (Mylerz)', cycle: 'تحويل كل خميس', data: b.mylerz }
      ];

      return `
        <div class="grid-kpi" style="margin-bottom:18px">
          <div class="card kpi-card">
            <span class="mu">رصيد جاهز للتحويل البنكي / إنستاباي</span>
            <b class="ok-tx">${fmtEGP(totalCollected)}</b>
            <div>${renderBadge('متاح للسحب الفوري', 'ok')}</div>
          </div>
          <div class="card kpi-card">
            <span class="mu">شحنات قيد التحصيل مع المناديب</span>
            <b>${fmtEGP(totalPending)}</b>
            <div>${renderBadge('تحت التسليم', 'wn')}</div>
          </div>
          <div class="card kpi-card">
            <span class="mu">إجمالي رسوم الشحن والتحصيل المخصومة</span>
            <b class="er-tx">${fmtEGP(totalFees)}</b>
            <div>${renderBadge('شامل ضريبة الشحن', 'er')}</div>
          </div>
          <div class="card kpi-card">
            <span class="mu">حساب الاستلام المربوط</span>
            <b style="font-size:17px" dir="ltr">${esc(state.instaPayHandle)}</b>
            <div>${renderBadge('InstaPay & تحويل بنكي', 'pr')}</div>
          </div>
        </div>

        <div class="card">
          <div class="row-wrap" style="margin-bottom:16px">
            <div>
              <h3>كشف تسوية شركات الشحن (Cash on Delivery)</h3>
              <p class="mu" style="font-size:13.5px">اطلب سحب المبالغ المحصّلة بعد خصم مصاريف الشحن مباشرة إلى حسابك البنكي أو إنستاباي.</p>
            </div>
          </div>
