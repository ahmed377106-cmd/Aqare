                </div>
                <div class="card" style="padding:14px">
                  <b class="pr-tx" style="font-size:13.5px;display:block;margin-bottom:4px">💵 السيولة وتحصيلات COD</b>
                  <p style="font-size:13px">${esc(d.cashflowAndCodTip)}</p>
                </div>
              </div>
            </div>
          `;
          panel.innerHTML = state.aiAdvisorHtml;
          showToast('✨ اكتمل التحليل الذكي للمتجر بواسطة Gemini');
        }
      } catch (err) {
        panel.innerHTML = '';
        panel.style.marginBottom = '0';
        showToast('⚠️ تعذر الاتصال بالمستشار الذكي حالياً');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `✨ تحليل المتجر بالذكاء الاصطناعي (Gemini)`;
        }
      }
    };

    actions['close-advisor'] = () => {
      state.aiAdvisorHtml = '';
      const panel = $('#ai-advisor-panel');
      if (panel) {
        panel.innerHTML = '';
        panel.style.marginBottom = '0';
      }
    };

    actions['ai-order-msg'] = async (el) => {
      const o = orders.find(x => x.id == el.dataset.id);
      if (!o) return;

      openDialog(
        `💬 مساعد رسائل العملاء الذكي (الطلب #${o.id})`,
        `
          <div id="ai-msg-body" style="padding:16px 0;text-align:center">
            <span class="spinner" style="border-top-color:var(--pr);width:24px;height:24px"></span>
            <p class="mu" style="margin-top:8px">يقوم Gemini بصياغة رسالة واتساب مخصصة للعميل <b>${esc(o.customer)}</b> لتأكيد الطلب وتقليل احتمالية رفض الاستلام...</p>
          </div>
        `
      );

      try {
        const statusLabel = ORDER_STATUS[o.status].label;
        const systemPrompt = "أنت مسؤول خدمة عملاء محترف وودود في متجر إلكتروني مصري. اكتب رسالة واتساب قصيرة ومهذبة باللهجة المصرية الراقية.";
        const prompt = `اكتب رسالة واتساب للعميل "${o.customer}" من محافظة "${o.gov}" بخصوص طلبه رقم #${o.id} من متجر "${state.storeName}" عبر منصة "${MARKETPLACES[o.market].name}".
المنتج: ${o.items}
الإجمالي: ${o.total} ج.م (${o.pay})
شركة الشحن: ${o.courier}
حالة الطلب الحالية: ${statusLabel}

الهدف من الرسالة: تأكيد العنوان وموعد التوصيل بلطف لضمان استلام الشحنة وتقليل نسبة المرتجعات (RTO)، أو طمأنة العميل. لا تضع أي مقدمات خارج نص الرسالة الجاهزة للنسخ.`;

        const res = await callGeminiAPI({ prompt, systemPrompt });
        const box = $('#ai-msg-body');
        if (box) {
          box.style.textAlign = 'start';
          box.innerHTML = `
            <div class="row" style="margin-bottom:8px">
              <span class="ai-badge">✨ جاهزة للإرسال عبر واتساب</span>
              <span class="sp"></span>
              <span class="mu" style="font-size:12px">العميل: ${esc(o.customer)} (${o.gov})</span>
            </div>
            <textarea id="ai-wa-text" rows="6" style="font-size:14px;line-height:1.7">${esc(res.text.trim())}</textarea>
            <div class="row">
              <button class="btn sp" data-a="copy-wa-msg">📋 نسخ رسالة الواتساب</button>
            </div>
          `;
        }
      } catch (err) {
        const box = $('#ai-msg-body');
        if (box) {
          box.style.textAlign = 'start';
          box.innerHTML = `
            <textarea id="ai-wa-text" rows="5">أهلاً بحضرتك يا أستاذ/ة ${esc(o.customer)} 🌟\nمعاك خدمة عملاء ${esc(state.storeName)} بخصوص طلبك رقم #${o.id} (${esc(o.items)}) بقيمة ${fmtEGP(o.total)}.\nالطلب هيوصلك مع شركة شحن ${o.courier} لمحافظة ${o.gov}، بنأكد مع حضرتك العنوان ورقم الموبايل عشان يوصلك في أسرع وقت!</textarea>
            <button class="btn" style="width:100%" data-a="copy-wa-msg">📋 نسخ الرسالة</button>
          `;
        }
      }
    };

    actions['copy-wa-msg'] = () => {
      const ta = $('#ai-wa-text');
      if (!ta) return;
      ta.select();
      document.execCommand('copy');
      dlg.close();
      showToast('📋 تم نسخ رسالة الواتساب الذكية إلى الحافظة ✓');
    };

    actions['copy-tx'] = (el) => {
      const target = document.getElementById(el.dataset.target);
      if (!target) return;
      const temp = document.createElement('textarea');
      temp.value = target.innerText.trim();
      document.body.appendChild(temp);
      temp.select();
      document.execCommand('copy');
      document.body.removeChild(temp);
      showToast('📋 تم نسخ النص إلى الحافظة');
    };

    actions['export-csv'] = () => {
      const rows = [
        ['المنتج', 'SKU', 'الفئة', 'التكلفة', 'السعر', 'المخزون'],
        ...products.map(p => [p.name, p.sku, p.cat || '', p.cost, p.price, p.stock])
      ];
      const csvContent = '\uFEFF' + rows.map(r => r.join(',')).join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'omniarab-products.csv';
      a.click();
      URL.revokeObjectURL(url);
      showToast('📥 تم تحميل ملف المنتجات CSV بنجاح');
    };

    actions['toggle-int'] = (el) => {
      const k = el.dataset.k;
      state.integrations[k] ^= 1;
      saveAppState();
      showToast(state.integrations[k] ? 'تم تفعيل الربط والمزامنة ✓' : 'تم إيقاف الربط مؤقتًا');
      renderApp(true);
    };

    actions['toggle-notif'] = (el) => {
      const k = el.dataset.k;
      state.notifications[k] ^= 1;
      saveAppState();
      renderApp(true);
    };

    actions['save-settings'] = () => {
      state.storeName = $('#set-name').value.trim() || state.storeName;
      state.storeEmail = $('#set-email').value.trim() || state.storeEmail;
      state.storePhone = $('#set-phone').value.trim() || state.storePhone;
      state.taxId = $('#set-tax').value.trim() || state.taxId;
      state.instaPayHandle = $('#set-ipa').value.trim() || state.instaPayHandle;
      saveAppState();
      showToast('تم حفظ بيانات المتجر والإعدادات الضريبية ✓');
      renderApp(true);
    };

    actions['reset-demo'] = () => {
      localStorage.removeItem('omni_products_v2');
      localStorage.removeItem('omni_orders_v2');
      localStorage.removeItem('omni_state_v2');
      loadAppState();
      showToast('↺ تمت استعادة البيانات التجريبية الأصلية');
      renderApp(true);
    };

    actions.theme = () => {
      const root = document.documentElement;
      const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('omni_theme', next); } catch (_) {}
    };

    actions['sync-now'] = () => {
      state.lastSync = 'الآن';
      saveAppState();
      showToast('⟳ تمت مزامنة المخزون والأسعار والطلبات مع أمازون ونون وجوميا ✓');
      renderApp(true);
    };

    actions.logout = () => { location.hash = '#/'; };

    actions['upgrade-plan'] = () => {
      location.hash = '#/';
      setTimeout(() => {
        const el = $('#sec-pricing');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }, 80);
    };

    // معالجات حقول الإدخال الفورية
    inputs['prod-search'] = (el) => {
      state.prodQuery = el.value;
      $('#prod-table-box').innerHTML = renderProductsTable();
    };

    inputs['ord-search'] = (el) => {
      state.orderQuery = el.value;
      $('#ord-table-box').innerHTML = renderOrdersTable();
    };

    inputs['dash-range'] = (el) => {
      state.range = +el.value;
      saveAppState();
      renderApp(true);
    };

    inputs['ai-select-prod'] = (el) => {
      const p = products.find(x => x.id == el.value);
      if (p) {
        $('#ai-name').value = p.name;
        $('#ai-feats').value = `فئة ${p.cat || 'متميزة'}، خامات أصلية عالية الجودة، ضمان محلي وشحن سريع`;
        actions['ai-generate']();
      }
    };

    inputs['calc-run'] = () => {
      const vals = ['c-comm', 'c-price', 'c-cost', 'c-ship', 'c-rto'].map(id => +$('#' + id).value || 0);
      $('#calc-res-box').innerHTML = renderProfitCalcResult(vals);
    };

    inputs['calc-mkt'] = (el) => {
      $('#c-comm').value = el.value;
      inputs['calc-run']();
    };

    /* ==========================================================================
       8. ربط المستمعين والتشغيل الأولي (Event Listeners & Bootstrap)
       ========================================================================== */
    document.addEventListener('click', (ev) => {
      const btn = ev.target.closest('[data-a]');
      if (btn && actions[btn.dataset.a]) {
        actions[btn.dataset.a](btn);
      }
    });

    document.addEventListener('input', (ev) => {
      const inp = ev.target.closest('[data-i]');
      if (inp && inputs[inp.dataset.i]) {
        inputs[inp.dataset.i](inp);
      }
    });

    dlg.addEventListener('click', (ev) => {
      if (ev.target === dlg) dlg.close();
    });

    window.addEventListener('hashchange', () => renderApp());

    try {
      const savedTheme = localStorage.getItem('omni_theme');
      if (savedTheme) document.documentElement.dataset.theme = savedTheme;
    } catch (_) {}

    // محاكاة حية لعداد المبيعات في الصفحة التسويقية
    setInterval(() => {
      const profitEl = $('#hero-profit');
      if (!profitEl) return;
      const randMkt = Math.floor(Math.random() * 3);
      liveHeroStats[randMkt]++;
      liveHeroStats[3] += 55 + Math.floor(Math.random() * 130);
      [0, 1, 2].forEach(i => {
        const el = $('#hero-ord-' + i);
        if (el) el.textContent = fmtNum(liveHeroStats[i]) + ' طلب اليوم';
      });
      profitEl.textContent = '+' + fmtEGP(liveHeroStats[3]);
    }, 2800);

    renderApp();
  </script>
</body>
</html>