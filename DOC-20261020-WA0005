      </footer>
    `;

    /* ==========================================================================
       5. بناء شاشات لوحة التحكم الداخليّة (Dashboard Views)
       ========================================================================== */
    const views = {};

    // 5.1 لوحة التحكم الرئيسية (#/dash)
    const getDashboardKPIs = () => {
      const rangeFactor = { 7: 0.25, 30: 1, 90: 2.85 }[state.range] || 1;
      const marketFactor = { all: 1, a: 0.52, n: 0.31, j: 0.17 }[state.marketFilter] || 1;
      const factor = rangeFactor * marketFactor;

      const grossSales = Math.round(264000 * factor);
      const netProfit = Math.round(56800 * factor);
      const fees = Math.round(33400 * factor);
      const orderCount = Math.round(1420 * factor);
      const codPending = state.codBalances.bosta.collected + state.codBalances.aramex.collected + state.codBalances.mylerz.collected;

      return [
        { title: 'إجمالي المبيعات', value: fmtEGP(grossSales), badge: '+١٤٫٢٪ عن الفترة السابقة', cls: 'ok' },
        { title: 'صافي الربح الحقيقي', value: fmtEGP(netProfit), badge: 'هامش ربح ٢١٫٥٪', cls: 'ok' },
        { title: 'عمولات وضرائب المنصات', value: fmtEGP(fees), badge: 'شامل ١٤٪ ق.م', cls: 'wn' },
        { title: 'إجمالي الطلبات', value: fmtNum(orderCount) + ' طلب', badge: '٩٦٫٨٪ نسبة تسليم', cls: 'pr' },
        { title: 'تحصيلات COD جاهزة للتحويل', value: fmtEGP(codPending), badge: 'بوسطة · أرامكس · مايلرز', cls: 'ok' }
      ];
    };

    const renderSalesChart = () => {
      const months = ['نوفمبر', 'ديسمبر', 'يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر'];
      const revData = [120, 138, 145, 168, 159, 192, 182, 210, 204, 228, 245, 264];
      const profData = [25, 29, 31, 36, 33, 42, 39, 46, 44, 49, 53, 57];
      const mFactor = { all: 1, a: 0.52, n: 0.31, j: 0.17 }[state.marketFilter] || 1;

      return `
        <div class="row-wrap" style="margin-bottom:10px;font-size:12.5px">
          <span class="row"><i style="width:12px;height:12px;border-radius:4px;background:var(--pr);display:inline-block"></i> إجمالي المبيعات (ألف ج.م)</span>
          <span class="row"><i style="width:12px;height:12px;border-radius:4px;background:var(--ac);display:inline-block"></i> صافي الربح (ألف ج.م)</span>
        </div>
        <svg viewBox="0 0 640 235" width="100%" style="overflow:visible">
          ${[0, 70, 140, 210, 280].map((g, idx) => {
            const y = 195 - idx * 42;
            return `<line x1="25" y1="${y}" x2="625" y2="${y}" stroke="var(--bd)" stroke-dasharray="4 4"/>`;
          }).join('')}
          ${revData.map((rv, i) => {
            const adjRev = Math.round(rv * mFactor);
            const adjProf = Math.round(profData[i] * mFactor);
            const hRev = (adjRev / 280) * 168;
            const hProf = (adjProf / 280) * 168;
            const x = 578 - i * 49;
            return `
              <g>
                <rect x="${x}" y="${195 - hRev}" width="18" height="${hRev}" rx="5" fill="var(--pr)" opacity="${i === 11 ? '1' : '0.82'}">
                  <title>${months[i]} — المبيعات: ${fmtNum(adjRev)} ألف ج.م</title>
                </rect>
                <rect x="${x + 20}" y="${195 - hProf}" width="14" height="${hProf}" rx="4" fill="var(--ac)">
                  <title>${months[i]} — صافي الربح: ${fmtNum(adjProf)} ألف ج.م</title>
                </rect>
                <text x="${x + 17}" y="218" text-anchor="middle" fill="var(--mu)" font-size="11.5" font-weight="600">${months[i].slice(0, 3)}</text>
              </g>
            `;
          }).join('')}
        </svg>
      `;
    };

    views.dash = () => {
      const lowStockItems = products.filter(p => p.stock <= 15);
      const filteredOrders = orders.filter(o => state.marketFilter === 'all' || o.market === state.marketFilter).slice(0, 5);

      return `
        <div class="row-wrap" style="margin-bottom:16px">
          <span class="mu" style="font-weight:700;font-size:13.5px">تصفية حسب السوق:</span>
          ${[['all', 'كل الأسواق'], ['a', 'أمازون مصر'], ['n', 'نون مصر'], ['j', 'جوميا']].map(m => `
            <span class="pill ${state.marketFilter === m[0] ? 'on' : ''}" data-a="mkt-filter" data-v="${m[0]}">${m[1]}</span>
          `).join('')}
          <span class="sp"></span>
          <button class="btn btn-sm" style="background:linear-gradient(135deg,#0b5fd6,#7c3aed)" data-a="ai-store-advisor" id="btn-ai-advisor">
